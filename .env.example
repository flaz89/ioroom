# Copy to .env.local (not committed) and fill in. On Vercel: Project Settings -> Environment Variables.
# Host of the ioroom-sync Worker, without protocol (printed by `npm run sync:deploy`).
# Leave empty to run without shared rooms. localhost:8787 = `npm run sync:dev` (desktop only).
VITE_SYNC_HOST=

# Public address of the deployed app (e.g. https://ioroom.vercel.app). The Share panel uses it when the page
# runs on localhost/LAN, so QR codes and links point at the online app. Not needed on Vercel itself.
VITE_PUBLIC_URL=
